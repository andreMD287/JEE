    {
      "name": "3. SAGA de pedidos",
      "item": [
        {
          "name": "Caso 1 - Exito",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"CLIENTE-001\",\n  \"items\": [\n    {\n      \"productId\": {{productId}},\n      \"quantity\": 2\n    }\n  ],\n  \"simulatePaymentFailure\": false,\n  \"simulateConfirmationFailure\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const order = pm.response.json();",
                  "pm.collectionVariables.set(\"orderId\", order.orderId);",
                  "pm.test(\"pedido CONFIRMADO\", () => pm.expect(order.status).to.eql(\"CONFIRMADO\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Caso 1 - SAGA completada",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sagas/order/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sagas",
                "order",
                "{{orderId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"SAGA COMPLETED\", () => pm.expect(pm.response.json().status).to.eql(\"COMPLETED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Caso 2 - Inventario insuficiente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"CLIENTE-SIN-STOCK\",\n  \"items\": [\n    {\n      \"productId\": {{productId}},\n      \"quantity\": 50\n    }\n  ],\n  \"simulatePaymentFailure\": false,\n  \"simulateConfirmationFailure\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"codigo INSUFFICIENT_STOCK\", () => pm.expect(pm.response.json().code).to.eql(\"INSUFFICIENT_STOCK\"));",
                  "pm.sendRequest(pm.collectionVariables.get(\"baseUrl\") + \"/orders\", (err, res) => {",
                  "    const orders = res.json();",
                  "    pm.collectionVariables.set(\"orderId\", orders[orders.length - 1].orderId);",
                  "});"
                ]
              }
            }
          ]
        },
